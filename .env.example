# Copy to .env and fill in. Never commit .env.

# ---------------- ERPNext (NetSuite stand-in)
ERPNEXT_VERSION=v16.50.0
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_ADMIN_USER=Administrator
ERPNEXT_ADMIN_PASSWORD=admin
ERPNEXT_DB_ROOT_PASSWORD=admin
# Filled in after running python/scripts/setup_erpnext.py (integration user's token)
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Sales Order defaults for Shopify orders (LS-05). Written by setup_erpnext.py --write-env
ERPNEXT_COMPANY=
ERPNEXT_DEFAULT_WAREHOUSE=

# ---------------- Shopify (free dev store + Dev Dashboard app; see docs/SETUP.md, step 8)
# Store domain like your-store.myshopify.com. Client ID/secret from the app's Settings in the
# Dev Dashboard. Without a store yet, put any placeholder in SHOPIFY_CLIENT_SECRET to test LS-05
# with scripts/send_test_order.py.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ---------------- Airtable
# Personal Access Token scopes: data.records:read, data.records:write,
# schema.bases:read, schema.bases:write  — and grant it access to your POC base.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# ---------------- n8n
N8N_VERSION=2.39.6
# Public URL if you use the tunnel profile (e.g. https://xxxx.trycloudflare.com/)
N8N_PUBLIC_URL=http://localhost:5678/
# Shared secret both Airtable and ERPNext send in the X-LS-Webhook-Token header.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LS_WEBHOOK_TOKEN=
# Optional: Slack incoming-webhook URL for alerts. Leave blank to log alerts to the warehouse only.
SLACK_WEBHOOK_URL=
TZ=UTC

# ---------------- Warehouse (Postgres as Snowflake stand-in)
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
WAREHOUSE_DB=ls_warehouse
WAREHOUSE_USER=ls_admin
WAREHOUSE_PASSWORD=ls_admin_pw
